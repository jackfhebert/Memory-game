rules_version = '2';

// Deny all client SDK access. Reads/writes only happen through the
// analytics backend's service account (server/), which bypasses these
// rules via IAM - see ANALYTICS.md "GCP setup".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
